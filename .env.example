# ==============================================================================
# .env.example — Plantilla de configuración para CryptoIA
# Copiá este archivo como .env y completá con tus valores reales:
#   cp .env.example .env
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DATOS — PostgreSQL
# ------------------------------------------------------------------------------
DB_SERVER=192.168.1.6
DB_PORT=5432
DB_DATABASE=CryptoTrade
DB_USER=Crypto
DB_PASSWORD=TU_PASSWORD_AQUI

# ------------------------------------------------------------------------------
# SERVIDOR DE IAs — Ollama
# ------------------------------------------------------------------------------
SERVIDOR_IA=192.168.1.6
PUERTO_GPU0=11434
PUERTO_GPU1=11434
PUERTO_GPU2=11434
MODELO_GPU0=qwen2.5:7b
MODELO_GPU1=qwen2.5:7b
MODELO_GPU2=qwen2.5:7b

# ------------------------------------------------------------------------------
# BINANCE — API Trading Real / Testnet
# ------------------------------------------------------------------------------
# Obtener en: https://testnet.binance.vision/ (testnet) o https://www.binance.com/
BINANCE_API_KEY=TU_BINANCE_API_KEY_AQUI
BINANCE_SECRET=TU_BINANCE_SECRET_AQUI

# true = usa Binance Testnet (dinero ficticio), false = producción real
BINANCE_TESTNET=true

# false = paper trading (sin órdenes reales), true = órdenes reales en Binance
MODO_REAL=false

# ------------------------------------------------------------------------------
# TRADING
# ------------------------------------------------------------------------------
EXCHANGE=binance
SIMBOLO=BTC/USDT

# Temporalidad de las velas para análisis técnico.
# Debe coincidir aproximadamente con INTERVALO_MINUTOS.
# Opciones: 1m, 3m, 5m, 15m, 30m, 1h
TEMPORALIDAD=5m

# Intervalo entre ciclos del bot (en minutos)
INTERVALO_MINUTOS=7

# Capital total disponible para operar (en USDT)
# Con DCA activado, este capital se divide en DCA_NIVELES partes iguales
CAPITAL_INICIAL=10000

# ------------------------------------------------------------------------------
# GESTIÓN DE RIESGO
# ------------------------------------------------------------------------------
# Stop-Loss fijo: vende automáticamente si el precio cae este % desde la compra
# Recomendado: 1.5% (libera capital rápido) o 2.5% (más tolerante)
STOP_LOSS_PCT=1.5

# Take-Profit fijo: vende automáticamente si el precio sube este % desde la compra
TAKE_PROFIT_PCT=5.0

# Trailing Stop: protege ganancias cuando el precio sube
# ACTIVACION: % de ganancia necesario para activar el trailing stop
# PROTECCION: % mínimo de ganancia que se protege una vez activado
# Ejemplo: precio sube 2% (ACTIVACION) → SL sube para proteger al menos 0.5% (PROTECCION)
TRAILING_STOP_ACTIVACION_PCT=2.0
TRAILING_STOP_PROTECCION_PCT=0.5

# Venta defensiva determinista: si P&L >= este % y hay señal bajista → vender sin IA
VENTA_DEFENSIVA_PNL_MIN_PCT=1.0

# Máximo de operaciones por día
MAX_OPERACIONES_DIA=5

# Minutos de espera entre operaciones (cooldown)
COOLDOWN_MINUTOS=15

# Segundos entre verificaciones internas del bucle
INTERVALO_CICLO_SEG=60

# Comisiones del exchange: 0.1% compra + 0.1% venta = 0.2% total (Binance estándar)
# Usado para calcular el precio mínimo de venta rentable (guardia de equilibrio)
# Con BNB para pagar fees: 0.1% total
COMISION_TOTAL_PCT=0.2

# ------------------------------------------------------------------------------
# TIMEOUT DE POSICIÓN — Evitar quedar congelado
# ------------------------------------------------------------------------------
# Si el bot lleva más de CICLOS_MAX_EN_POSICION ciclos en la misma posición
# sin poder vender (precio bajo el equilibrio), fuerza la venta para liberar
# capital y poder operar en niveles más bajos.
# Ejemplo: 20 ciclos × 7 min = ~2.3 horas máximo atrapado
CICLOS_MAX_EN_POSICION=20

# Ciclos mínimos antes de permitir que la IA venda (evita salidas prematuras)
CICLOS_MIN_EN_POSICION=1

# Ciclos de espera tras un stop-loss antes de volver a comprar
COOLDOWN_POST_STOPLOSS=2

# ------------------------------------------------------------------------------
# COMPRA — Umbrales y lógica determinista
# ------------------------------------------------------------------------------
# Umbral mínimo de confianza de la IA para ejecutar una COMPRA (rango: 50-70)
# Valores más bajos = bot más agresivo para entrar
CONFIANZA_MIN_COMPRA=55

# Compra determinista: si true, compra cuando indicadores son alcistas aunque la IA diga ESPERAR
COMPRA_DETERMINISTA=true

# Rango de RSI válido para la compra determinista
# No compra si RSI > MAX (sobrecomprado) ni si RSI < MIN (caída libre)
COMPRA_DET_RSI_MIN=35
COMPRA_DET_RSI_MAX=65

# MACD histograma mínimo para permitir compra determinista
# Evita comprar en caída libre (MACD muy negativo)
MACD_HIST_MIN_COMPRA=-15.0

# ------------------------------------------------------------------------------
# VENTA — Protecciones de la IA
# ------------------------------------------------------------------------------
# P&L mínimo para que la IA pueda vender (debe cubrir comisiones del 0.2%)
# Con 0.25% se garantiza ganancia real después de comisiones
PNL_MIN_PARA_VENDER_IA=0.25

# Confianza mínima de la IA para vender con pérdida pequeña (venta forzada)
# Solo aplica si el precio está sobre el punto de equilibrio
CONFIANZA_VENTA_FORZADA=85

# Pérdida máxima permitida para venta forzada por IA (no reemplaza stop-loss)
PNL_MAX_PERDIDA_IA=-0.5

# ------------------------------------------------------------------------------
# DCA — Dollar Cost Averaging (Promediado de precio)
# ------------------------------------------------------------------------------
# El capital total (CAPITAL_INICIAL) se divide en DCA_NIVELES partes iguales.
# La compra inicial usa 1 parte. Si el precio baja DCA_BAJADA_PCT%, se compra
# otra parte. Así hasta agotar los niveles. NUNCA se supera CAPITAL_INICIAL.
#
# Ejemplo con CAPITAL_INICIAL=10000 y DCA_NIVELES=4:
#   - Capital por nivel: $2.500
#   - Compra inicial:    $2.500 a $60.400
#   - Precio baja 0.5%:  $2.500 más a $60.098 → promedio $60.249
#   - Precio baja 0.5%:  $2.500 más a $59.797 → promedio $60.098
#   - Precio baja 0.5%:  $2.500 más a $59.498 → promedio $59.948
#   - Total invertido:   $10.000 (nunca más)
#
# IMPORTANTE: Activar solo cuando tenés el capital completo disponible.
DCA_HABILITADO=false
DCA_NIVELES=4
DCA_BAJADA_PCT=0.5

# ------------------------------------------------------------------------------
# ZONA HORARIA Y LOGGING
# ------------------------------------------------------------------------------
TIMEZONE=America/Argentina/Buenos_Aires
LOG_NIVEL=INFO
