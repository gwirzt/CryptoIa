# ==============================================================================
# .env.example — Plantilla de configuración para CryptoIA
# Copiá este archivo como .env y completá con tus valores reales:
#   cp .env.example .env
# NUNCA subas el archivo .env al repositorio
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVIDOR DE IAs — Ollama
# ------------------------------------------------------------------------------
SERVIDOR_IA=192.168.1.8
PUERTO_GPU0=11431
PUERTO_GPU1=11432
PUERTO_GPU2=11433
MODELO_GPU0=qwen2.5:7b
MODELO_GPU1=qwen2.5:3b
MODELO_GPU2=qwen2.5:3b

# ------------------------------------------------------------------------------
# BINANCE — API Trading Real / Testnet
# ------------------------------------------------------------------------------
# Obtener en: https://testnet.binance.vision/ (testnet) o https://www.binance.com/
BINANCE_API_KEY=TU_BINANCE_API_KEY_AQUI
BINANCE_SECRET=TU_BINANCE_SECRET_AQUI

# true = usa Binance Testnet (dinero ficticio), false = producción real
BINANCE_TESTNET=true

# false = paper trading (sin órdenes reales), true = órdenes reales en Binance
MODO_REAL=false

# ------------------------------------------------------------------------------
# BASE DE DATOS — PostgreSQL
# ------------------------------------------------------------------------------
DB_SERVER=192.168.1.8
DB_PORT=5432
DB_DATABASE=CryptoTrade
DB_USER=Crypto
DB_PASSWORD=TU_PASSWORD_AQUI

# ------------------------------------------------------------------------------
# TRADING
# ------------------------------------------------------------------------------
EXCHANGE=binance
SIMBOLO=BTC/USDT

# Temporalidad de las velas para análisis técnico.
# IMPORTANTE: debe coincidir con INTERVALO_MINUTOS para analizar datos frescos.
# Opciones: 1m, 3m, 5m, 7m, 15m, 30m, 1h
# Ejemplo ciclos cada 7 min → TEMPORALIDAD=5m, INTERVALO_MINUTOS=7
# Ejemplo ciclos cada 15 min → TEMPORALIDAD=15m, INTERVALO_MINUTOS=15
TEMPORALIDAD=15m

CAPITAL_INICIAL=10000

# ------------------------------------------------------------------------------
# GESTIÓN DE RIESGO
# ------------------------------------------------------------------------------
# Stop-Loss fijo: vende automáticamente si el precio cae este % desde la compra
STOP_LOSS_PCT=2.5

# Take-Profit fijo: vende automáticamente si el precio sube este % desde la compra
TAKE_PROFIT_PCT=5.0

# Trailing Stop: se activa cuando el P&L supera TRAILING_STOP_ACTIVACION_PCT
# y mueve el SL hacia arriba para proteger al menos TRAILING_STOP_PROTECCION_PCT de ganancia.
# Ejemplo: compré a $100.000, precio sube a $102.100 (>2%) → SL sube a $100.500 (protejo +0.5%)
TRAILING_STOP_ACTIVACION_PCT=2.0
TRAILING_STOP_PROTECCION_PCT=0.5

# Venta defensiva determinista (sin consultar IA):
# Si el P&L >= VENTA_DEFENSIVA_PNL_MIN_PCT Y los indicadores técnicos se deterioran → VENDER
# Esto garantiza que nunca se pierde una ganancia por esperar al próximo ciclo de IA.
VENTA_DEFENSIVA_PNL_MIN_PCT=1.0

MAX_OPERACIONES_DIA=5
COOLDOWN_MINUTOS=15
INTERVALO_CICLO_SEG=60

# Intervalo entre ciclos del bot (en minutos).
# Recomendado: usar el mismo valor que TEMPORALIDAD (o el más cercano disponible).
INTERVALO_MINUTOS=15

# Máximo de ciclos consecutivos en posición antes de forzar evaluación de salida
CICLOS_MAX_EN_POSICION=8

# Zona horaria para timestamps (formato IANA)
TIMEZONE=America/Argentina/Buenos_Aires

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_NIVEL=INFO
